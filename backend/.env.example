PORT=4000
NODE_ENV=development

# Postgres local (sin Docker) - crea la base primero: createdb soporte_redes_industriales
DATABASE_URL="postgresql://postgres:password@localhost:5432/soporte_redes_industriales?schema=public"

# Umbral en segundos: si un gateway no reporta en este tiempo, se abre un incidente por silencio
HEARTBEAT_TIMEOUT_SECONDS=90

# Token inicial que el seed asigna al gateway IOT2040 de prueba
SEED_GATEWAY_TOKEN=dev-gateway-token-change-me

CORS_ORIGIN=http://localhost:5173
